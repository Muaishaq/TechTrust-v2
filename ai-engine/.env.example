# TechTrust AI Engine Environment Variables
# @file        .env.example
# @description Template for AI engine environment variables.
#              Copy to .env and fill in real values.
#              NEVER commit .env to GitHub.
# @author      Muaishaq
# @created     2026-07-02

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Must match AI_ENGINE_API_KEY in backend .env
API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Same MongoDB Atlas connection as backend
MONGODB_URI=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Optional — increases GitHub API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG