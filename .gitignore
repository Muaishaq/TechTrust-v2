# @file        .gitignore
# @description Git ignore rules for TechTrust — Node.js, Python, env files, logs, IDE, OS, MongoDB, coverage
# @author      Muaishaq
# @created     2026-06-25
# @modified    2026-06-25

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.pnpm-store
dist/
build/
*.tsbuildinfo

# --- Python ---
venv/
.venv/
penv/
env/
.env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# --- Environment files ---
.env
.env.local
.env.production
.env.development
.env.test
.env.staging
*.env

# --- Log files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE files ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- MongoDB ---
data/db/
mongo-data/
dump/
*.bson
*.mongodb
*.mongorc.js

# --- Coverage reports ---
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
*.lcov
lcov.info
junit.xml
test-results/

# --- Misc build and cache ---
.cache/
.temp/
tmp/
temp/
*.local
